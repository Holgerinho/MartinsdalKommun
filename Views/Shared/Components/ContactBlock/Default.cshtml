@model MartinsdalKommun.Models.ViewModels.ContactBlockViewModel

<div class="contact">
	<img epi-property="@Model.Image" />
	<h2 epi-property="@Model.Heading">@Model.Heading</h2>
	<h3 epi-property="@Model.Subheading">@Model.Subheading</h3>
	<p epi-property="@Model.Text">@Model.Text</p>
	<a href="tel:@Model.Phone" epi-property="@Model.Phone">@Model.Phone</a>
	<a href="mailto:@Model.Email" epi-property="@Model.Email">@Model.Email</a>
</div>
