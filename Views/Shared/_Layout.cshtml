@using EPiServer.Core
@using MartinsdalKommun.Models.Pages
@using MartinsdalKommun.Models.ViewModels
@inject EPiServer.IContentLoader ContentLoader

@model dynamic

@{var startPage = ContentLoader.Get<StartPage>
(ContentReference.StartPage);}

<!DOCTYPE html>
<html>
<body>


    @{
        await Html.RenderPartialAsync("~/Views/Shared/Header.cshtml", startPage);
    }

    <main>
        @RenderBody()
    </main>

    @{
        await Html.RenderPartialAsync("~/Views/Shared/Footer.cshtml", startPage);
    }

</body>
</html>
